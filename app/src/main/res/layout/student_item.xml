<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/card_background">

    <!-- Avatar Icon -->
    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="@string/app_name"
        android:padding="8dp"
        android:src="@drawable/ic_student_avatar" />

    <!-- Student Name -->
    <TextView
        android:id="@+id/tvStudentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Visual Status Badge Indicator -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_status_absent"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/status_absent"
        android:textColor="@color/status_absent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Attendance Selection Spinner -->
    <Spinner
        android:id="@+id/spinnerAttendance"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="100dp"
        android:spinnerMode="dropdown"
        android:popupBackground="@color/white"
        android:backgroundTint="@color/text_secondary" />

</LinearLayout>